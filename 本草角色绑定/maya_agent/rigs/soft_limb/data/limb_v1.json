  "expression": "float $len_coeff = strech_ik_foot1.lenght_coeff;\nfloat $leng_base=leng_base.translateX;\nfloat $len1=strech_ik_foot1.lenght_joint_1;\nfloat $len2=strech_ik_foot1.lenght_joint_2;\nfloat $soft_start_alpha=90*strech_ik_foot1.softness;\nfloat $full_straight_coeff=strech_ik_foot1.full_straight_coeff;\nfloat $scale_coeff= 1-strech_ik_foot1.scale_coeff;\nfloat $predel= ($len1 + $len2)/2 *strech_ik_foot1.bend_limit  ;\nif($len1>$len2)\n\t$workdist=$len1;\nelse\n\t$workdist=$len2;\n$leg_len=($len1 + $len2);\n$delta_len=$leg_len*$len_coeff;\n$full_leg_len_f=$leg_len +$delta_len;\n$full_leg_len=$leg_len+$delta_len*$full_straight_coeff;\nfloat $cos_a= clamp(-1,1,($len1*$len1 + $leng_base*$leng_base  -  $len2*$len2)/(2 *$len1*$leng_base));\n$alpha = acosd($cos_a);\n$knee_positionX =$len1*$cos_a;\n$knee_positionY =$len1*sind ($alpha);\n$over_dist=   $leng_base-$leg_len;\n$feet_pos=clamp (0, $full_leg_len_f, $leng_base);\nif($len_coeff>0&&$over_dist>0)\n{\n\t$proport=$len1/$leg_len;\n\t$knee_positionX=$feet_pos*$proport;\n}\n$soft_start_positionY =$len1*sind ($soft_start_alpha);\n$first_katet =$len1*cosd ($soft_start_alpha);\n$second_katet=sqrt(abs($len2*$len2 - $soft_start_positionY*$soft_start_positionY));\n$soft_base_len=$first_katet+$second_katet;\nfloat $soft_knee_pivotY ;\nfloat $soft_scale_range;\n\tif($soft_start_positionY <= $knee_positionY)\n\t{\n\t\t$soft_knee_pivotY=$knee_positionY;\n\t\t$soft_scale_range=1;\n\t}\n\telse if($feet_pos>$workdist)\n\t{\n\t\t$soft_knee_pivotY = $soft_start_positionY;\n\t\t$soft_clamp_range= 1-($soft_base_len-clamp ($soft_base_len, $full_leg_len, $leng_base))/($soft_base_len-$full_leg_len);\n\t\t$soft_knee_pivotY=$soft_start_positionY* $soft_clamp_range ;\n\t}\n\telse\n\t{\n\t\t$soft_knee_pivotY=$knee_positionY;\n\t}\nif($len_coeff>0)\n\t$soft_scale_range= 1-$scale_coeff + $scale_coeff*(1-($soft_base_len-clamp ($soft_base_len, $full_leg_len_f, $leng_base))/($soft_base_len-$full_leg_len_f)) ;\nelse\n\t$soft_scale_range=1;\nif($soft_knee_pivotY< $predel&&$feet_pos>$workdist)\n\t$soft_knee_pivotY= $predel;\nsoft_knee_gr.translateX=$knee_positionX;\npivot_feet.translateX=$feet_pos;\nsoft_knee_gr.translateY=$soft_knee_pivotY;\nmultiplyDivide3.input1X=$soft_scale_range;",
